# Object storage (S3-compatible). Leave S3_ENDPOINT empty for AWS.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=verdict
S3_ACCESS_KEY_ID=verdict
S3_SECRET_ACCESS_KEY=verdictdev
S3_REGION=us-east-1

# Index database
SQLITE_PATH=.data/verdict.sqlite

# Artifact source: "fixtures" or "github"
SOURCE=fixtures
FIXTURES_DIR=fixtures

# GitHub App (SOURCE=github)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_REPOS=owner/repo,owner/other

# Viewer auth
VERDICT_PASSWORD=change-me
SESSION_SECRET=change-me-too

PORT=3000
ARTIFACT_PORT=3001
