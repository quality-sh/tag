# Object storage (S3-compatible). Leave S3_ENDPOINT empty for AWS.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=tag
S3_ACCESS_KEY_ID=tag
S3_SECRET_ACCESS_KEY=tagdev
S3_REGION=us-east-1

# Index database
SQLITE_PATH=.data/tag.sqlite

# Artifact source: "fixtures" or "github"
SOURCE=
FIXTURES_DIR=fixtures

# GitHub (SOURCE=github; the default once either credential is set). Permissions: Actions
# read, Contents read, Pull requests read, Deployments read, Metadata read.
#
# App mode is the primary path: the App is registered once for the org, and an admin opens
# the "Install on GitHub" link the dashboard shows when GITHUB_APP_SLUG is set. The
# installation id is recorded from the redirect, so GITHUB_INSTALLATION_ID is only a seed
# for the first boot and can stay empty.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_INSTALLATION_ID=
# Token mode is the self-hosted and local path: a fine-grained token and a repository list.
GITHUB_TOKEN=
# Comma-separated; empty lets an App see every repository it is installed on.
GITHUB_REPOS=owner/repo,owner/other
# GitHub Enterprise Server: https://ghe.example.com/api/v3
GITHUB_API_URL=
# App mode: the App's webhook secret. Point the App's webhook at /api/webhooks/github and
# subscribe it to workflow_run. Empty answers that endpoint with 404.
GITHUB_WEBHOOK_SECRET=

# Viewer auth: the shared password, OIDC login, or both (docs/deploy.md, "OIDC login").
TAG_PASSWORD=change-me
SESSION_SECRET=change-me-too
# OIDC turns on when the issuer, client id and secret are all set. Register
# ${PUBLIC_URL}/api/auth/oidc/callback with the provider as the redirect URI.
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ALLOWED_DOMAINS=example.com
# OIDC_PROVIDER_NAME=Google
# PUBLIC_URL=https://tag.example.com

PORT=3000
ARTIFACT_PORT=3001

# Cached artifact files (Playwright reports, traces) older than this many days leave the
# store on the next sweep; the normalized reports stay forever. 0 disables the sweep.
ARTIFACT_RETENTION_DAYS=90

# Minutes between backstop ingest passes, for runs a webhook delivery missed; token mode
# has no webhook, so this is its only automatic ingest. 0 disables the poll.
INGEST_POLL_MINUTES=10
